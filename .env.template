# Telegram
TELEGRAM_BOT_TOKEN=

# LLM: ollama (по умолчанию) или vllm (при переезде на серверную GPU)
LLM_PROVIDER=ollama
# По умолчанию — docker compose (сервис ollama).
# Для локального запуска с host-Ollama замените на http://localhost:11434/v1
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_REQUEST_TIMEOUT=180

# PostgreSQL (по умолчанию — docker compose, сервис db).
# Для локального запуска замените на localhost:5432
DATABASE_URL=postgresql+asyncpg://ai_trainer:ai_trainer@db:5432/ai_trainer
DATABASE_ECHO=false

# RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RETRIEVAL_TOP_K=5

# STT (устройство можно переключить на cuda при переезде на большую GPU)
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ru

# Веб-поиск (дополнение к базе знаний, включён)
WEB_SEARCH_ENABLED=true
# TTL кэша успешных выдач поиска, секунды (защита от повторов и бана DDG)
WEB_SEARCH_CACHE_TTL=600
# Скачивать текст top-N страниц для обогащения контекста (снипет бывает пустым)
WEB_SEARCH_PAGE_FETCH=true
# Сколько верхних результатов обогащать текстом страницы (до реракнкинга будет скачено)
WEB_SEARCH_PAGE_COUNT=5
# Максимальное количество результатов, запрашиваемых у поисковой системы
WEB_FETCH_LIMIT=5
# Количество результатов веб-поиска, включаемых в контекст LLM (после реранкинга)
WEB_RESULTS_IN_CONTEXT=3
# Максимальное количество результатов с одного домена
WEB_RESULTS_PER_DOMAIN=1
# Таймаут загрузки веб-страницы в секундах
WEB_PAGE_TIMEOUT=5.0
# Максимальное количество символов со страницы
WEB_PAGE_MAX_CHARS=800

# Тренажёр
TRAINER_CASES_MAX=5

# Логи
LOG_LEVEL=INFO

# Ссылка на исходный код и лицензия
SOURCE_CODE_URL=https://github.com/vladislav-serdyuk/ai-trainer
